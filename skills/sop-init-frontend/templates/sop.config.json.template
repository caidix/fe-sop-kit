{
  "srcDirs": ["src"],
  "codeExtensions": [".ts", ".tsx", ".js", ".jsx", ".vue"],
  "styleExtensions": [".less", ".css", ".scss", ".sass", ".styl"],
  "maxFileLines": 300,
  "maxWarningsPerCheck": 5,
  "checks": {
    "maxFileLines": true,
    "consoleLog": true,
    "anyType": true,
    "dangerousApi": true,
    "todoComment": false,
    "hardcodedColor": true
  },
  "ignore": ["**/*.test.*", "**/*.spec.*", "**/node_modules/**", "**/dist/**", "**/build/**"],
  "colorAllowPatterns": [],
  "kit": {
    "repo": "https://github.com/caidix/fe-sop-kit",
    "branch": "master",
    "version": "4.2",
    "commit": "",
    "checkRemote": true
  },
  "budgets": {
    "agentsMaxChars": 4500,
    "ruleMaxChars": 10000,
    "rulesTotalMaxChars": 40000
  }
}
